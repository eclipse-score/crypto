@startuml score_crypto_api_overview

title Score Crypto API — Stack, Factory & Context Overview

skinparam packageStyle rectangle

' ============================================================
' Factory
' ============================================================
package "Factory" {
    class CryptoStackConfig <<struct>> {
        + connection_endpoint : string
        + default_operation_timeout : optional<milliseconds>
        ---
        + SetConnectionEndpoint(endpoint) : CryptoStackConfig&
        + SetDefaultOperationTimeout(timeout) : CryptoStackConfig&
    }

    interface "CreateCryptoStack" as CreateCryptoStack {
        + CreateCryptoStack(config : CryptoStackConfig) : Result<ICryptoStack::Uptr>
    }
}

' ============================================================
' Stack & Resource Ownership
' ============================================================
package "Stack & Ownership" {
    interface ICryptoStack {
        + CreateCryptoContext() : Result<ICryptoContext::Uptr>
        + GetMemoryAllocator() : Result<IMemoryAllocator::Uptr>
    }

    interface IMemoryAllocator {
        + Allocate(size, provider_type = nullopt) : Result<IReadWriteMemory::Uptr>
        + Allocate(size, provider : CryptoResourceId) : Result<IReadWriteMemory::Uptr>
        + GetQuota() : size_t
        + GetCurrentUsage() : size_t
    }

}

' ============================================================
' ICryptoContext
' ============================================================
package "Crypto Context" {
    interface ICryptoContext {
        __ Resource Resolution __
        + ResolveResource(resource_id, type) : Result<CryptoResourceId>
        __ Context Factory (Crypto) __
        + CreateHashContext(config) : Result<IHashContext::Uptr>
        + CreateMacContext(config) : Result<IMacContext::Uptr>
        + CreateKeyManagementContext(config) : Result<IKeyManagementContext::Uptr>
        + CreateCipherContext(config) : Result<ICipherContext::Uptr>
        + CreateSignContext(config) : Result<ISignContext::Uptr>
        + CreateVerifySignatureContext(config) : Result<IVerifySignatureContext::Uptr>
        + CreateAeadContext(config) : Result<IAeadContext::Uptr>
        + CreateRandomContext(config) : Result<IRandomContext::Uptr>
        __ Context Factory (Certificate) __
        + CreateCertificateManagementContext(config) : Result<ICertificateManagementContext::Uptr>
        + CreateCertificateVerificationContext(config) : Result<ICertificateVerificationContext::Uptr>
        + CreateCsrGenerationContext(config) : Result<ICsrGenerationContext::Uptr>
        + CreateCsrProcessingContext(config) : Result<ICsrProcessingContext::Uptr>
        __ Queries __
        + QueryCapabilities(algorithm) : Result<AlgorithmCapabilities>
        + QueryCapabilities() : Result<SystemCapabilities>
        + QueryProviderCompatibility(resource) : Result<ProviderCompatibilityInfo>
        + GetProviderInfo(provider_id) : Result<ProviderInfo>
        __ Typed Object Access __
        + GetKeyObject(id) : Result<IKeyObject::Uptr>
        + GetKeySlotObject(id) : Result<IKeySlotObject::Uptr>
        + GetCertificateObject(id) : Result<ICertificateObject::Uptr>
        + GetCertSlotObject(id) : Result<ICertSlotObject::Uptr>
        + GetProviderObject(id) : Result<IProviderObject::Uptr>
    }

    ICryptoContext -[hidden]-> ICryptoStack

    interface ICsrProcessingContext
    interface ICsrProcessingService {
        + Process(document) : Result<Document>
    }
    interface IContext
    ICsrProcessingContext --|> IContext
    ICsrProcessingContext --|> ICsrProcessingService : existing helper seam
    ICryptoContext --> ICsrProcessingContext : CTX_CREATE / CTX_CLOSE lifetime
    note right of ICsrProcessingContext
        Keyless CSR helpers and templates use this context.
        No CSR-specific creation method belongs to ICryptoStack.
        Processing uses the context node, not a mediator query.
        This API view contains no daemon implementation types.
    end note
    note right of ICsrProcessingService
        Value-only helper seam; no connection or transcoder.
        Transport client is a separate adapter/header.
        Daemon backend selection does not change this API
        or the current wire/DER encode/decode contracts.
    end note
}

' ============================================================
' Relationships
' ============================================================
CreateCryptoStack ..> CryptoStackConfig : accepts
CreateCryptoStack --> ICryptoStack : creates
ICryptoStack --> ICryptoContext : creates
ICryptoStack --> IMemoryAllocator : provides

@enduml
